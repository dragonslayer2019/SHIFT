{{ 'section-shift-commerce.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign story_media = product.media[1]
  assign story_copy = product.metafields.custom.use_case
  if story_copy == blank and product.description != blank
    assign story_copy = product.description | strip_html | split: '.' | first | append: '.'
  endif
-%}

{%- if story_media != blank and story_media.preview_image != blank -%}
  <section class="shift-commerce shift-product-story color-{{ section.settings.color_scheme }} gradient" aria-labelledby="ShiftProductStory-{{ section.id }}">
    <div class="shift-product-story__inner page-width">
      <div class="shift-product-story__media">
        {{
          story_media.preview_image
          | image_url: width: 1600
          | image_tag:
            widths: '550, 750, 1100, 1500',
            sizes: '(min-width: 750px) 58vw, 100vw',
            loading: 'lazy',
            alt: story_media.alt
        }}
      </div>
      <div class="shift-product-story__copy">
        <h2 id="ShiftProductStory-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if story_copy != blank -%}<p>{{ story_copy | escape }}</p>{%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "SHIFT product story",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See it in the space." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "presets": [{ "name": "SHIFT product story" }]
}
{% endschema %}
