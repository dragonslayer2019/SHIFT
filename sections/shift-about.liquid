{{ 'section-shift-about.css' | asset_url | stylesheet_tag }}

<section class="shift-about color-{{ section.settings.color_scheme }} gradient">
  <div class="shift-about__inner page-width">
    <div class="shift-about__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            widths: '550, 750, 1100, 1500, 1800',
            sizes: '(min-width: 750px) 55vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.image_alt
        }}
      {%- else -%}
        <img
          src="{{ 'shift-demo-ugc-living-corner.jpg' | asset_url }}"
          alt="{{ section.settings.image_alt | escape }}"
          width="1280"
          height="1600"
          loading="eager"
          fetchpriority="high"
        >
      {%- endif -%}
    </div>

    <div class="shift-about__content">
      <h1 class="shift-about__title">{{ page.title | default: section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="shift-about__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="shift-about__actions">
        {%- if section.settings.living_label != blank and section.settings.living_link != blank -%}
          <a class="button" href="{{ section.settings.living_link }}">{{ section.settings.living_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.desk_label != blank and section.settings.desk_link != blank -%}
          <a class="button button--secondary" href="{{ section.settings.desk_link }}">{{ section.settings.desk_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About SHIFT",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Small-space image" },
    { "type": "text", "id": "image_alt", "label": "Image alternative text", "default": "A warm compact apartment arranged for living and working" },
    { "type": "text", "id": "heading", "label": "Fallback heading", "default": "About SHIFT" },
    { "type": "richtext", "id": "text", "label": "Story", "default": "<p>SHIFT began with the experience of moving from China to Japan and rebuilding the rhythms of everyday life in a smaller home.</p><p>When one room has to hold living, working, and unwinding, every object needs a clear reason to be there. The useful things can still bring color, character, and a little joy.</p><p>We look for pieces that earn their place: practical for limited space, easy to live with, and good to see every day.</p>" },
    { "type": "text", "id": "living_label", "label": "Living button label", "default": "Shop living spaces" },
    { "type": "url", "id": "living_link", "label": "Living button link" },
    { "type": "text", "id": "desk_label", "label": "Desk button label", "default": "Shop desk spaces" },
    { "type": "url", "id": "desk_link", "label": "Desk button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "About SHIFT" }]
}
{% endschema %}
