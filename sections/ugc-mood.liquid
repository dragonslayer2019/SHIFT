{{ 'section-ugc-mood.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ugc-mood.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #UgcMood-{{ section.id }} {
    --ugc-mood-radius: {{ section.settings.card_radius }}px;
    --ugc-mood-transition-ms: {{ section.settings.transition_duration }}ms;
  }
{%- endstyle -%}

<section
  id="UgcMood-{{ section.id }}"
  class="ugc-mood"
  data-section-type="ugc-mood"
  data-section-id="{{ section.id }}"
  role="region"
  aria-label="{{ section.settings.heading | default: 'User stories' | escape }}"
>
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="ugc-mood__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="ugc-mood__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="ugc-mood__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="ugc-mood__carousel">
    <div class="ugc-mood__track">
      {%- for block in section.blocks -%}
        <div
          class="ugc-mood__card{% if forloop.first %} is-active{% endif %}"
          data-index="{{ forloop.index0 }}"
          data-block-id="{{ block.id }}"
          data-emotion="{{ block.settings.emotion_key | handle }}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- comment -%} ── Card Image (top half with fade) ── {%- endcomment -%}
          <div class="ugc-mood__card-image">
            {%- if block.settings.card_image != blank -%}
              {{
                block.settings.card_image
                | image_url: width: 960
                | image_tag:
                  widths: '480, 640, 960',
                  sizes: '(max-width: 749px) 80vw, 480px',
                  loading: 'lazy',
                  class: 'ugc-mood__img'
              }}
              {{
                block.settings.card_image
                | image_url: width: 960
                | image_tag:
                  widths: '480, 640, 960',
                  sizes: '(max-width: 749px) 80vw, 480px',
                  loading: 'lazy',
                  class: 'ugc-mood__img-blur',
                  aria-hidden: 'true'
              }}
            {%- else -%}
              <div class="ugc-mood__img-placeholder">
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <rect width="48" height="48" rx="8" fill="currentColor" opacity="0.06"/>
                  <path d="M14 34l8-10 6 7 4-5 6 8H14z" fill="currentColor" opacity="0.15"/>
                  <circle cx="32" cy="18" r="4" fill="currentColor" opacity="0.15"/>
                </svg>
              </div>
            {%- endif -%}
            <div class="ugc-mood__frost-fade" aria-hidden="true"></div>
            <div class="ugc-mood__frost-solid" aria-hidden="true"></div>
          </div>

          {%- comment -%} ── Card Content (bottom half) ── {%- endcomment -%}
          <div class="ugc-mood__card-body">
            {%- if block.settings.card_title != blank -%}
              <h3 class="ugc-mood__card-title">{{ block.settings.card_title }}</h3>
            {%- endif -%}

            {%- if block.settings.review_text != blank -%}
              <p class="ugc-mood__card-excerpt">{{ block.settings.review_text | truncate: 100 }}</p>
            {%- endif -%}

            <button class="ugc-mood__read-more" data-modal-target="ugc-modal-{{ block.id }}" aria-label="Read more about {{ block.settings.card_title | escape }}">
              Read more
            </button>
          </div>
        </div>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        <div class="ugc-mood__empty">
          <p>Add mood card blocks in the theme editor</p>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ── Navigation Arrows ── {%- endcomment -%}
    {%- if section.blocks.size > 1 -%}
      <button
        class="ugc-mood__nav ugc-mood__nav--prev"
        aria-label="{{ 'accessibility.previous_slide' | t }}"
      >
        <span class="ugc-mood__arrow ugc-mood__arrow--left">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
      <button
        class="ugc-mood__nav ugc-mood__nav--next"
        aria-label="{{ 'accessibility.next_slide' | t }}"
      >
        <span class="ugc-mood__arrow ugc-mood__arrow--right">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    {%- endif -%}
  </div>

  {%- comment -%} ── Modals ── {%- endcomment -%}
  {%- for block in section.blocks -%}
    <div class="ugc-mood__modal" id="ugc-modal-{{ block.id }}" aria-hidden="true" role="dialog" aria-modal="true">
      <div class="ugc-mood__modal-backdrop"></div>
      <div class="ugc-mood__modal-content">
        <button class="ugc-mood__modal-close" aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>

        {%- if block.settings.card_image != blank -%}
          <div class="ugc-mood__modal-image">
            {{
              block.settings.card_image
              | image_url: width: 1200
              | image_tag:
                widths: '600, 900, 1200',
                sizes: '(max-width: 749px) 100vw, 600px',
                loading: 'lazy',
                class: 'ugc-mood__modal-img'
            }}
          </div>
        {%- endif -%}

        <div class="ugc-mood__modal-body">
          {%- if block.settings.card_title != blank -%}
            <h3 class="ugc-mood__modal-title">{{ block.settings.card_title }}</h3>
          {%- endif -%}

          <div class="ugc-mood__modal-meta">
            {%- if block.settings.reviewer_avatar != blank -%}
              <div class="ugc-mood__avatar">
                {{
                  block.settings.reviewer_avatar
                  | image_url: width: 120
                  | image_tag:
                    widths: '60, 80, 120',
                    sizes: '40px',
                    loading: 'lazy',
                    class: 'ugc-mood__avatar-img'
                }}
              </div>
            {%- endif -%}
            <div class="ugc-mood__modal-reviewer">
              {%- if block.settings.reviewer_name != blank -%}
                <span class="ugc-mood__reviewer-name">{{ block.settings.reviewer_name }}</span>
              {%- endif -%}
              {%- if block.settings.star_rating > 0 -%}
                <div class="ugc-mood__stars" aria-label="{{ block.settings.star_rating }} out of 5 stars">
                  {%- for i in (1..5) -%}
                    <svg class="ugc-mood__star{% if i <= block.settings.star_rating %} ugc-mood__star--filled{% endif %}" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M8 1.5l1.85 3.75L14 5.9l-3 2.92.71 4.13L8 10.94l-3.71 1.95L5 8.82 2 5.9l4.15-.65L8 1.5z" fill="currentColor"/>
                    </svg>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          </div>

          {%- if block.settings.review_text != blank -%}
            <blockquote class="ugc-mood__modal-quote">
              <p>{{ block.settings.review_text }}</p>
            </blockquote>
          {%- endif -%}

          {%- if block.settings.product_mention != blank -%}
            <span class="ugc-mood__product-tag">{{ block.settings.product_mention }}</span>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "UGC Mood",
  "tag": "section",
  "class": "section-ugc-mood",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "They felt it too."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real stories from people who shifted their space — and how it shifted them."
    },
    {
      "type": "header",
      "content": "Card Style"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "transition_duration",
      "label": "Card transition duration",
      "min": 300,
      "max": 1200,
      "step": 100,
      "default": 600,
      "unit": "ms"
    }
  ],
  "blocks": [
    {
      "type": "mood_card",
      "name": "Mood Card",
      "settings": [
        {
          "type": "header",
          "content": "Card Display"
        },
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Card image",
          "info": "Top half of card. Recommended: 960×600px"
        },
        {
          "type": "text",
          "id": "card_title",
          "label": "Card title",
          "default": "Real Time Stress Analytics"
        },
        {
          "type": "header",
          "content": "Emotion & Trigger"
        },
        {
          "type": "text",
          "id": "emotion_key",
          "label": "Emotion key (internal)",
          "default": "anxious",
          "info": "Used for matching, e.g.: anxious, drained, lost"
        },
        {
          "type": "text",
          "id": "emotion_icon",
          "label": "Emotion emoji",
          "default": "😰"
        },
        {
          "type": "text",
          "id": "emotion_label",
          "label": "Emotion display text",
          "default": "Anxious"
        },
        {
          "type": "color",
          "id": "emotion_color",
          "label": "Emotion accent color",
          "default": "#9B8EC4"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Trigger button text",
          "default": "I feel anxious"
        },
        {
          "type": "header",
          "content": "Review Content (Modal)"
        },
        {
          "type": "image_picker",
          "id": "reviewer_avatar",
          "label": "Reviewer avatar"
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer name",
          "default": "Sarah K."
        },
        {
          "type": "range",
          "id": "star_rating",
          "label": "Star rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review text",
          "default": "I didn't think a candle could change how a room feels. But lighting it after a long day turned my anxious evenings into something I actually look forward to."
        },
        {
          "type": "text",
          "id": "product_mention",
          "label": "Product mention",
          "default": "Calm Evening Candle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGC Mood",
      "blocks": [
        {
          "type": "mood_card",
          "settings": {
            "card_title": "A Calmer Evening Ritual",
            "emotion_key": "anxious",
            "emotion_icon": "😰",
            "emotion_label": "Anxious",
            "emotion_color": "#9B8EC4",
            "button_label": "I feel anxious",
            "reviewer_name": "Sarah K.",
            "star_rating": 5,
            "review_text": "I didn't think a candle could change how a room feels. But lighting it after a long day turned my anxious evenings into something I actually look forward to.",
            "product_mention": "Calm Evening Candle"
          }
        },
        {
          "type": "mood_card",
          "settings": {
            "card_title": "Rest That Actually Restores",
            "emotion_key": "drained",
            "emotion_icon": "😮‍💨",
            "emotion_label": "Drained",
            "emotion_color": "#5AAFCF",
            "button_label": "I feel drained",
            "reviewer_name": "Marcus T.",
            "star_rating": 5,
            "review_text": "After burning out at work, I rearranged my reading nook with this throw and the softest cushion. Now it's the first place I go — and somehow, I actually rest.",
            "product_mention": "Cloud Rest Throw"
          }
        },
        {
          "type": "mood_card",
          "settings": {
            "card_title": "Finding Home Again",
            "emotion_key": "lost",
            "emotion_icon": "😶‍🌫️",
            "emotion_label": "Lost",
            "emotion_color": "#E8735A",
            "button_label": "I feel lost",
            "reviewer_name": "Yuki A.",
            "star_rating": 5,
            "review_text": "I moved into a new city knowing no one. This little ceramic set on my kitchen counter made it feel like home for the first time. It's silly, but it mattered.",
            "product_mention": "Mornings Ceramic Set"
          }
        }
      ]
    }
  ]
}
{% endschema %}
