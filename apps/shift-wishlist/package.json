{
  "name": "shift-wishlist",
  "private": true,
  "scripts": {
    "build": "shopify app build --config production",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "config:validate": "shopify app config validate --config production --json",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "test": "node --test extensions/saved-pieces/src/*.test.js",
    "lint": "eslint --ignore-path .gitignore --ignore-pattern 'extensions/*/shopify.d.ts' --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "typecheck": "tsc --project extensions/saved-pieces/tsconfig.json --noEmit"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.18.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "extensions/*"
  ],
  "author": "alan"
}
