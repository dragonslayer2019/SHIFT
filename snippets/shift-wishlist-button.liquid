{% doc %}
  Renders a progressively enhanced wishlist toggle.

  @param {product} product - Product represented by the button.
  @param {string} [context] - Visual context: card or product.
{% enddoc %}

{%- liquid
  assign button_context = context | default: 'card'
  assign save_label = 'wishlist.save_product' | t: title: product.title
-%}

<shift-wishlist-button
  class="shift-wishlist-button shift-wishlist-button--{{ button_context }} no-js-hidden"
  data-product-handle="{{ product.handle | escape }}"
  data-product-title="{{ product.title | escape }}"
  data-save-label="{{ save_label | escape }}"
  data-remove-label="{{ 'wishlist.remove_product' | t: title: product.title | escape }}"
  data-save-text="{{ 'wishlist.save' | t | escape }}"
  data-saved-text="{{ 'wishlist.saved' | t | escape }}"
>
  <button type="button" class="shift-wishlist-button__control{% if button_context == 'product' %} button button--secondary{% endif %}" aria-label="{{ save_label | escape }}" aria-pressed="false">
    <span class="shift-wishlist-button__icon">{% render 'icon-heart' %}</span>
    {%- if button_context == 'product' -%}
      <span class="shift-wishlist-button__label" data-wishlist-label>{{ 'wishlist.save' | t }}</span>
    {%- endif -%}
  </button>
</shift-wishlist-button>
