{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": { "type": "text", "settings": { "text": "{{ product.vendor }}", "text_style": "uppercase" } },
        "title": { "type": "title" },
        "price": { "type": "price" },
        "variant_picker": { "type": "variant_picker", "settings": { "picker_type": "button", "swatch_shape": "circle" } },
        "quantity_selector": { "type": "quantity_selector" },
        "buy_buttons": { "type": "buy_buttons", "settings": { "show_dynamic_checkout": true, "show_gift_card_recipient": true } },
        "description": { "type": "description" },
        "share": { "type": "share", "settings": { "share_label": "Share" } }
      },
      "block_order": ["vendor", "title", "price", "variant_picker", "quantity_selector", "buy_buttons", "description", "share"],
      "settings": { "enable_sticky_info": true, "color_scheme": "scheme-1", "media_position": "left", "gallery_layout": "stacked", "media_size": "large", "constrain_to_viewport": true, "media_fit": "contain", "image_zoom": "lightbox", "mobile_thumbnails": "show", "hide_variants": true, "enable_video_looping": false, "padding_top": 36, "padding_bottom": 24 }
    },
    "space_details": {
      "type": "shift-product-details",
      "blocks": {
        "dimensions": { "type": "detail", "settings": { "source": "dimensions", "label": "Dimensions", "placeholder": "[Add exact product dimensions before launch]" } },
        "best_for": { "type": "detail", "settings": { "source": "best_for", "label": "Best for", "placeholder": "[Add room type, desk size, and clearance guidance]" } },
        "helps_with": { "type": "detail", "settings": { "source": "helps_with", "label": "Helps with", "placeholder": "[Add the practical inconvenience this product addresses]" } },
        "setup": { "type": "detail", "settings": { "source": "setup", "label": "Setup & care", "placeholder": "[Add installation, rental-safety, and care details]" } }
      },
      "block_order": ["dimensions", "best_for", "helps_with", "setup"],
      "settings": { "eyebrow": "Know before it arrives", "heading": "Will it work in your space?", "intro": "These fields use product metafields when available. Placeholder text below must be replaced before launch.", "color_scheme": "scheme-2" }
    },
    "disclosures": { "type": "disclosures", "settings": { "padding_top": 36, "padding_bottom": 0 } },
    "related-products": {
      "type": "related-products",
      "settings": { "heading": "More ways to make the space work", "heading_size": "h2", "products_to_show": 4, "columns_desktop": 4, "color_scheme": "scheme-1", "image_ratio": "square", "image_shape": "default", "show_secondary_image": true, "show_vendor": false, "show_rating": false, "columns_mobile": "2", "padding_top": 48, "padding_bottom": 48 }
    }
  },
  "order": ["main", "space_details", "disclosures", "related-products"]
}
